{
  "include": [
    "**/src/**/*.js",
    "**/src/**/*.jsx",
    "**/src/**/*.ts",
    "**/src/**/*.tsx"
  ],
  "parserPlugins": [
    "asyncGenerators",
    "bigInt",
    "classProperties",
    "classPrivateProperties",
    "classPrivateMethods",
    "dynamicImport",
    "importMeta",
    "numericSeparator",
    "objectRestSpread",
    "optionalCatchBinding",
    "topLevelAwait",
    "typescript",
    "jsx"
  ],
  "reporter": [
    "lcov",
    "text-summary",
    "html"
  ],
  "extension": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx"
  ]
}
