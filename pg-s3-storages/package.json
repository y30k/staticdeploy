{
  "name": "@staticdeploy/pg-s3-storages",
  "description": "Pg + S3 storages for StaticDeploy",
  "version": "0.15.5",
  "private": true,
  "main": "lib/index.js",
  "typings": "lib/index.d.js",
  "files": [
    "lib"
  ],
  "author": "Paolo Scanferla <paolo.scanferla@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/staticdeploy/staticdeploy.git"
  },
  "bugs": {
    "url": "https://github.com/staticdeploy/staticdeploy/issues"
  },
  "scripts": {
    "compile": "rimraf lib && tsc",
    "test": "NODE_ENV=test NODE_PATH=src TS_NODE_FILES=true TS_NODE_COMPILER_OPTIONS='{\"types\":[\"mocha\",\"node\"]}' mocha -t 20000 -r ts-node/register --extension ts 'test/**/*.ts'",
    "start-test-containers:minio": "docker run --rm -p 127.0.0.1:9000:9000 -e MINIO_ACCESS_KEY=accessKeyId -e MINIO_SECRET_KEY=secretAccessKey minio/minio:RELEASE.2021-11-24T23-19-33Z server /data",
    "start-test-containers:pg": "docker run --rm -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=password postgres:13",
    "start-test-containers": "npm-run-all -p start-test-containers:*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@staticdeploy/core": "^0.15.5",
    "bluebird": "^3.7.2",
    "knex": "3.1.0",
    "lodash": "^4.17.21",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@staticdeploy/storages-test-suite": "^0.15.5",
    "@types/bluebird": "^3.5.36",
    "@types/chai": "4.3.20",
    "@types/lodash": "^4.14.178",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "chai": "4.5.0",
    "mocha": "11.8.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
